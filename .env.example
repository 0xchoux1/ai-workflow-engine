# ========================================
# n8n 設定
# ========================================

# Basic認証（本番環境では必ず変更してください）
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=changeme

# n8nのホスト設定
N8N_HOST=localhost
N8N_PROTOCOL=http
N8N_WEBHOOK_URL=http://localhost:5678/

# タイムゾーン
TIMEZONE=Asia/Tokyo

# ========================================
# Dify 設定
# ========================================

# Difyのシークレットキー（本番環境では必ず変更してください）
DIFY_SECRET_KEY=your-secret-key-here-replace-this

# DifyのURL設定
DIFY_CONSOLE_URL=http://localhost:3000
DIFY_API_URL=http://localhost:5001

# ログレベル（DEBUG, INFO, WARNING, ERROR）
LOG_LEVEL=INFO

# ========================================
# PostgreSQL 設定（Dify用）
# ========================================

POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme_db_password
POSTGRES_DB=dify

# ========================================
# Redis 設定
# ========================================

REDIS_PASSWORD=changeme_redis_password

# ========================================
# Weaviate 設定（ベクトルデータベース）
# ========================================

WEAVIATE_API_KEY=changeme_weaviate_api_key

# ========================================
# LLMプロバイダー設定（オプション）
# ========================================

# OpenAI
# OPENAI_API_KEY=your-openai-api-key-here

# Anthropic Claude
# ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Azure OpenAI
# AZURE_OPENAI_API_KEY=your-azure-openai-api-key-here
# AZURE_OPENAI_ENDPOINT=https://your-endpoint.openai.azure.com/

# ========================================
# セキュリティに関する重要な注意事項
# ========================================

# 本番環境では以下を必ず実施してください：
# 1. すべてのパスワードとシークレットキーを強力なものに変更
# 2. .envファイルを.gitignoreに追加（既に追加済み）
# 3. HTTPS（TLS/SSL）の設定
# 4. ファイアウォールの設定
# 5. 定期的なバックアップの実施
